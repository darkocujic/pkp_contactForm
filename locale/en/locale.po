msgid "plugins.generic.contactForm.displayName"
msgstr "Contact Form"

msgid "plugins.generic.contactForm.description"
msgstr ""
"Adds a public \"Contact us\" page with a spam-resistant message form. "
"Messages are emailed to the journal and archived so none are lost if "
"delivery fails."

msgid "plugins.generic.contactForm.navigationMenuItem"
msgstr "Contact form"

msgid "plugins.generic.contactForm.navigationMenuItem.description"
msgstr "A link to this journal's contact form page."

msgid "plugins.generic.contactForm.messages"
msgstr "Messages"

msgid "plugins.generic.contactForm.page.title"
msgstr "Contact us"

msgid "plugins.generic.contactForm.submit"
msgstr "Send message"

msgid "plugins.generic.contactForm.sent"
msgstr "Thank you. Your message has been sent."

msgid "plugins.generic.contactForm.field.name"
msgstr "Your name"

msgid "plugins.generic.contactForm.field.email"
msgstr "Your email address"

msgid "plugins.generic.contactForm.field.email.description"
msgstr "We will only use this to reply to you."

msgid "plugins.generic.contactForm.field.subject"
msgstr "Subject"

msgid "plugins.generic.contactForm.field.message"
msgstr "Message"

msgid "plugins.generic.contactForm.captcha.label"
msgstr "Confirm that you are not a robot"

msgid "plugins.generic.contactForm.decoy.label"
msgstr "Leave this field empty"

msgid "plugins.generic.contactForm.error.nameRequired"
msgstr "Please enter your name."

msgid "plugins.generic.contactForm.error.nameTooLong"
msgstr "Your name is too long. Please shorten it."

msgid "plugins.generic.contactForm.error.emailInvalid"
msgstr "Please enter a valid email address so that we can reply."

msgid "plugins.generic.contactForm.error.subjectRequired"
msgstr "Please enter a subject."

msgid "plugins.generic.contactForm.error.subjectTooLong"
msgstr "The subject is too long. Please shorten it."

msgid "plugins.generic.contactForm.error.bodyRequired"
msgstr "Please enter your message."

msgid "plugins.generic.contactForm.error.bodyTooLong"
msgstr "Your message is too long. Please shorten it or send it by email instead."

msgid "plugins.generic.contactForm.error.captcha"
msgstr "Please complete the anti-spam challenge."

msgid "plugins.generic.contactForm.error.rejected"
msgstr ""
"Your message could not be submitted. If you are a person rather than a "
"robot, please wait a moment, reload this page and try again, or email the "
"journal directly."

msgid "plugins.generic.contactForm.error.notSent"
msgstr ""
"Your message could not be sent because of a problem on our side. Please try "
"again later, or email the journal directly."

msgid "plugins.generic.contactForm.emails.notification.name"
msgstr "Contact form message"

msgid "plugins.generic.contactForm.emails.notification.description"
msgstr "Sent to the journal when a visitor submits the contact form."

msgid "plugins.generic.contactForm.emails.acknowledgement.name"
msgstr "Contact form acknowledgement"

msgid "plugins.generic.contactForm.emails.acknowledgement.description"
msgstr ""
"Sent to the visitor to confirm that their message arrived, if the journal "
"has enabled acknowledgements."

msgid "plugins.generic.contactForm.emails.variable.senderName"
msgstr "The name the visitor entered"

msgid "plugins.generic.contactForm.emails.variable.senderEmail"
msgstr "The email address the visitor entered"

msgid "plugins.generic.contactForm.emails.variable.messageSubject"
msgstr "The subject the visitor entered"

msgid "plugins.generic.contactForm.emails.variable.messageBody"
msgstr "The message the visitor entered"

msgid "plugins.generic.contactForm.emails.variable.submittedAt"
msgstr "The date and time the message was received"

msgid "plugins.generic.contactForm.settings.page"
msgstr "The page"

msgid "plugins.generic.contactForm.settings.page.description"
msgstr ""
"The form is published at <a href=\"{$url}\">{$url}</a>. Add a link to it "
"under Settings &gt; Website &gt; Navigation using the \"Contact form\" item "
"type."

msgid "plugins.generic.contactForm.settings.pagePath"
msgstr "Page address"

msgid "plugins.generic.contactForm.settings.pageTitle"
msgstr "Page title"

msgid "plugins.generic.contactForm.settings.introText"
msgstr "Introduction shown above the form"

msgid "plugins.generic.contactForm.settings.recipient"
msgstr "Where messages go"

msgid "plugins.generic.contactForm.settings.recipientEmail"
msgstr "Recipient email address"

msgid "plugins.generic.contactForm.settings.recipientName"
msgstr "Recipient name"

msgid "plugins.generic.contactForm.settings.ccEmails"
msgstr "Copy to (one address per line, up to ten)"

msgid "plugins.generic.contactForm.settings.requireSubject"
msgstr "Require a subject"

msgid "plugins.generic.contactForm.settings.enableAcknowledgement"
msgstr "Send an acknowledgement to the visitor"

msgid "plugins.generic.contactForm.settings.enableAcknowledgement.warning"
msgstr ""
"Acknowledgements are sent to whatever address the visitor types, so enabling "
"this lets anyone make this journal send mail to a third party. The "
"acknowledgement deliberately contains none of the visitor's own text, and it "
"counts against the rate limits below."

msgid "plugins.generic.contactForm.settings.spam"
msgstr "Spam protection"

msgid "plugins.generic.contactForm.settings.captcha.on"
msgstr ""
"reCAPTCHA is configured for this installation, so the form shows a challenge."

msgid "plugins.generic.contactForm.settings.captcha.off"
msgstr ""
"reCAPTCHA is not configured for this installation, so no challenge is shown. "
"To enable it, set recaptcha and the two key options in the [captcha] section "
"of config.inc.php. The other protections below work regardless."

msgid "plugins.generic.contactForm.settings.honeypotMinSeconds"
msgstr "Minimum seconds before a message may be sent (0 to disable)"

msgid "plugins.generic.contactForm.settings.honeypotMaxSeconds"
msgstr "Maximum seconds a form stays valid (0 to disable)"

msgid "plugins.generic.contactForm.settings.regenerateHoneypotField"
msgstr "Give the hidden decoy field a new name when saving"

msgid "plugins.generic.contactForm.settings.honeypotFieldName"
msgstr "The decoy field is currently named \"{$name}\"."

msgid "plugins.generic.contactForm.settings.maxUrls"
msgstr "Links allowed in a message"

msgid "plugins.generic.contactForm.settings.maxPerHourPerIp"
msgstr "Messages per hour from one visitor (0 for no limit)"

msgid "plugins.generic.contactForm.settings.maxPerHourPerContext"
msgstr "Messages per hour for this journal (0 for no limit)"

msgid "plugins.generic.contactForm.settings.blocklist"
msgstr "Blocked words, one per line"

msgid "plugins.generic.contactForm.settings.retention"
msgstr "Stored messages"

msgid "plugins.generic.contactForm.settings.storeSubmissions"
msgstr "Store submitted messages"

msgid "plugins.generic.contactForm.settings.storeSubmissions.description"
msgstr ""
"When off, no message content is ever written to the database — not the "
"name, email address, subject or message text, and not the sender's IP "
"address either. Only a hashed, time-limited record is kept, purely to "
"enforce the rate limits below; it cannot be used to recover a submitted "
"message. The journal still receives the notification email as usual. The "
"\"Messages\" list has nothing to show while this is off, and the setting "
"below no longer applies."

msgid "plugins.generic.contactForm.settings.retentionDays"
msgstr "Keep messages for this many days"

msgid "plugins.generic.contactForm.settings.retentionDays.description"
msgstr ""
"Use 0 to keep messages indefinitely. Stored messages contain personal data, "
"so choose a period your privacy policy supports and mention the contact form "
"in the journal's privacy statement."

msgid "plugins.generic.contactForm.settings.error.pagePath"
msgstr "The page address is required and may contain only letters and digits."

msgid "plugins.generic.contactForm.settings.error.recipientEmail"
msgstr ""
"Enter a valid recipient email address, or leave it empty to use the "
"journal's principal contact."

msgid "plugins.generic.contactForm.settings.error.ccEmails"
msgstr "One of the copy-to addresses is not a valid email address."

msgid "plugins.generic.contactForm.settings.error.number"
msgstr "Enter a whole number of 0 or more."

msgid "plugins.generic.contactForm.settings.error.timing"
msgstr "The minimum time must be shorter than the maximum time."

msgid "plugins.generic.contactForm.messages.count"
msgstr "{$total} message(s) stored."

msgid "plugins.generic.contactForm.messages.retention"
msgstr "Messages are deleted automatically after {$days} day(s)."

msgid "plugins.generic.contactForm.messages.retention.forever"
msgstr "Messages are kept indefinitely."

msgid "plugins.generic.contactForm.messages.none"
msgstr "No messages have been received yet."

msgid "plugins.generic.contactForm.messages.storageDisabled"
msgstr ""
"Message storage is turned off in this plugin's settings, so there is "
"nothing to show here. Submitted messages are still emailed to the "
"journal as usual; they are simply never written to the database."

msgid "plugins.generic.contactForm.messages.received"
msgstr "Received"

msgid "plugins.generic.contactForm.messages.from"
msgstr "From"

msgid "plugins.generic.contactForm.messages.delivered"
msgstr "Emailed"

msgid "plugins.generic.contactForm.messages.showMessage"
msgstr "Show message"

msgid "plugins.generic.contactForm.messages.confirmDelete"
msgstr "Permanently delete this message?"

msgid "plugins.generic.contactForm.messages.page"
msgstr "Page {$current} of {$last}"

msgid "plugins.generic.contactForm.task.purge"
msgstr "Delete expired contact form messages"

msgid "plugins.generic.contactForm.task.purge.notInstalled"
msgstr "The Contact Form plugin could not be loaded; nothing was deleted."

msgid "plugins.generic.contactForm.task.purge.removed"
msgstr "Deleted {$count} expired contact form message(s)."
