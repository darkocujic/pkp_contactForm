msgid "emails.contactFormNotification.subject"
msgstr "[{$contextName}] {$messageSubject}"

msgid "emails.contactFormNotification.body"
msgstr ""
"<p>A message has been sent through the contact form on {$contextName}.</p>\n"
"<p>\n"
"<strong>From:</strong> {$senderName} &lt;{$senderEmail}&gt;<br/>\n"
"<strong>Subject:</strong> {$messageSubject}<br/>\n"
"<strong>Received:</strong> {$submittedAt}\n"
"</p>\n"
"<hr/>\n"
"<p>{$messageBody}</p>\n"
"<hr/>\n"
"<p>Reply to this email to answer {$senderName} directly.</p>"

msgid "emails.contactFormAcknowledgement.subject"
msgstr "Your message to {$contextName}"

msgid "emails.contactFormAcknowledgement.body"
msgstr ""
"<p>Thank you for contacting {$contextName}.</p>\n"
"<p>Your message was received on {$submittedAt} and has been passed to the "
"journal. Someone will reply if a response is needed — you do not need to do "
"anything further.</p>\n"
"<p>This is an automatic confirmation; please do not reply to it.</p>\n"
"<p>{$contextSignature}</p>"
